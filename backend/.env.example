# Shopify Custom App Credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here
# read_orders is required for the orders/paid|cancelled|refunded webhooks to carry
# line_items + properties (needed to reconcile a Shopify order with an R2 order).
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_customers,write_draft_orders,read_draft_orders

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name

# Admin panel password — sent as the X-Admin-Key header
ADMIN_SECRET_KEY=choose_a_long_random_string

# Signs the Shopify customerId passed from the Liquid template's iframe embed.
# MUST exactly match the `session_secret` assigned in
# shopify-liquid/page.gang-sheet-sample.liquid, or every customer is treated as a
# logged-out guest. Generate with: openssl rand -hex 32
SESSION_SIGNING_SECRET=generate_with_openssl_rand_hex_32

# Verifies Shopify order webhooks (orders/paid, orders/cancelled, orders/refunded).
# For a custom app, this is the app's API Secret Key (same value as SHOPIFY_API_SECRET).
SHOPIFY_WEBHOOK_SECRET=same_as_shopify_api_secret

# Server Config (production URLs after deploy)
HOST=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.vercel.app
PORT=3000

# Set to "production" on the live server. When set, an unverified Shopify webhook
# (missing SHOPIFY_WEBHOOK_SECRET) is rejected instead of trusted.
NODE_ENV=production

# Optional: extra CORS origins, comma-separated (localhost + the known store
# domains are already allowed by default).
# EXTRA_ALLOWED_ORIGINS=https://staging.example.com,https://another.example.com
